  <version>0.0.0</version>
  <description>Rovert-O top-level bringup launch files (sim mission).</description>
  <maintainer email="gomezluis2907@gmail.com">gomezluis2907</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>roverto_description</exec_depend>
  <exec_depend>roverto_gazebo</exec_depend>
  <exec_depend>roverto_navigation</exec_depend>
  <exec_depend>roverto_autonomy</exec_depend>
  <exec_depend>ldlidar_stl_ros2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
